# ── Supabase (existing) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Site (existing) ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://souqphone.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Cloudflare R2 — new web product-image storage (S3-compatible) ─────
# Server-only secrets: NEVER prefix with NEXT_PUBLIC_, never use in the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the R2 custom domain serving product images, no trailing
# slash (e.g. https://images.souqphone.com). Must match the r2PublicBase
# constant pinned in supabase/migrations/*_publish_web_product_r2_urls.sql.
R2_PUBLIC_URL=https://images.souqphone.com

# ── Client-safe mirror of the R2 public base (no secrets) ─────────────
# Enables the R2 upload path in /mobiles/add and R2 URL rendering.
# When empty, the web falls back to the legacy Supabase Storage flow.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.souqphone.com

# ── Google AdSense ───────────────────────────────────────────────────
# AdSense Publisher Client ID (Auto Ads)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6148113554332836
# Feature flag to enable/disable ads site-wide ("true" | "false")
NEXT_PUBLIC_ENABLE_ADS=true

